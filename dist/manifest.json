{
  "manifest_version": 3,
  "name": "BugSnap — One-click Bug Reporter",
  "version": "0.1.0",
  "description": "Capture website bugs and prepare clear, shareable reports.",
  "action": {
    "default_title": "Open BugSnap",
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
